#include <stdio.h>
#include <ctype.h>
#include <string.h>

// Function to find modular inverse of a modulo 26
int modInverse(int a) {
    for (int i = 1; i < 26; i++) {
        if ((a * i) % 26 == 1)
            return i;
    }
    return -1;
}

int main() {
    char cipher[200];
    int a = 3, b = 15;
    int a_inv = modInverse(a);

    printf("Enter ciphertext: ");
    fgets(cipher, sizeof(cipher), stdin);

    printf("Plaintext: ");

    for (int i = 0; cipher[i] != '\0'; i++) {
        if (isupper(cipher[i])) {
            int c = cipher[i] - 'A';
            int p = (a_inv * (c - b + 26)) % 26;
            printf("%c", p + 'A');
        }
        else if (islower(cipher[i])) {
            int c = cipher[i] - 'a';
            int p = (a_inv * (c - b + 26)) % 26;
            printf("%c", p + 'a');
        }
        else {
            printf("%c", cipher[i]);
        }
    }

    return 0;
}
