# Q22: S-DES in CBC Mode
# 8-bit block, 10-bit key

P10 = [3,5,2,7,4,10,1,9,8,6]
P8  = [6,3,7,4,8,5,10,9]

IP  = [2,6,3,1,4,8,5,7]
IP_INV = [4,1,3,5,7,2,8,6]

EP  = [4,1,2,3,2,3,4,1]
P4  = [2,4,3,1]

S0 = [
    [1,0,3,2],
    [3,2,1,0],
    [0,2,1,3],
    [3,1,3,2]
]

S1 = [
    [0,1,2,3],
    [2,0,1,3],
    [3,0,1,0],
    [2,1,0,3]
]


def permute(bits, table):
    return [bits[i-1] for i in table]


def left_shift(bits, n):
    return bits[n:] + bits[:n]


def xor(a, b):
    return [x ^ y for x, y in zip(a, b)]


def generate_keys(key):
    p10 = permute(key, P10)

    left = p10[:5]
    right = p10[5:]

    left = left_shift(left, 1)
    right = left_shift(right, 1)

    k1 = permute(left + right, P8)

    left = left_shift(left, 2)
    right = left_shift(right, 2)

    k2 = permute(left + right, P8)

    return k1, k2


def sbox_lookup(bits, sbox):
    row = bits[0] * 2 + bits[3]
    col = bits[1] * 2 + bits[2]

    value = sbox[row][col]

    return [value // 2, value % 2]


def fk(bits, key):
    left = bits[:4]
    right = bits[4:]

    expanded = permute(right, EP)
    xored = xor(expanded, key)

    s0_bits = sbox_lookup(xored[:4], S0)
    s1_bits = sbox_lookup(xored[4:], S1)

    p4 = permute(s0_bits + s1_bits, P4)

    return xor(left, p4) + right


def switch(bits):
    return bits[4:] + bits[:4]


def sdes_encrypt(block, k1, k2):
    bits = permute(block, IP)

    bits = fk(bits, k1)
    bits = switch(bits)
    bits = fk(bits, k2)

    return permute(bits, IP_INV)


def sdes_decrypt(block, k1, k2):
    bits = permute(block, IP)

    bits = fk(bits, k2)
    bits = switch(bits)
    bits = fk(bits, k1)

    return permute(bits, IP_INV)


def string_to_bits(s):
    return [int(x) for x in s]


def bits_to_string(bits):
    return ''.join(map(str, bits))


# --------------------------------------------------
# CBC encryption
# --------------------------------------------------

print("S-DES CBC MODE")
print("--------------")

key_string = input("Enter 10-bit key: ")
iv_string = input("Enter 8-bit IV: ")
plaintext_string = input("Enter 16-bit plaintext: ")

key = string_to_bits(key_string)
iv = string_to_bits(iv_string)
plaintext = string_to_bits(plaintext_string)

k1, k2 = generate_keys(key)

print("\nK1:", bits_to_string(k1))
print("K2:", bits_to_string(k2))

ciphertext = []
previous = iv

for i in range(0, len(plaintext), 8):

    block = plaintext[i:i+8]

    # CBC: XOR plaintext with previous ciphertext
    xored = xor(block, previous)

    encrypted = sdes_encrypt(xored, k1, k2)

    ciphertext.extend(encrypted)

    previous = encrypted


print("\nCiphertext:")
print(bits_to_string(ciphertext))


# --------------------------------------------------
# CBC decryption
# --------------------------------------------------

decrypted = []
previous = iv

for i in range(0, len(ciphertext), 8):

    block = ciphertext[i:i+8]

    decrypted_block = sdes_decrypt(block, k1, k2)

    original = xor(decrypted_block, previous)

    decrypted.extend(original)

    previous = block


print("\nDecrypted plaintext:")
print(bits_to_string(decrypted))
