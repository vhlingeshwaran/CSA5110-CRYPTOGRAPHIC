# Q25: RSA Common-Factor Attack
#
# If plaintext m shares a non-trivial factor with n,
# gcd(m, n) can reveal a factor of n.

import math


print("RSA COMMON FACTOR ATTACK")
print("------------------------")

n = int(input("Enter RSA modulus n: "))
m = int(input("Enter plaintext block m: "))

# Calculate gcd
g = math.gcd(m, n)

print("\ngcd(m, n) =", g)

if g == 1:

    print("\nNo common factor was found.")
    print("This plaintext block does not help factor n.")

elif g == n:

    print("\nThe plaintext is a multiple of n.")
    print("It does not reveal a non-trivial factor.")

else:

    print("\nA non-trivial common factor was found!")
    print("Factor of n =", g)

    p = g
    q = n // p

    print("p =", p)
    print("q =", q)

    phi = (p - 1) * (q - 1)

    print("phi(n) =", phi)

    print("\nTherefore n has been factored.")
    print("This can allow the RSA private key to be recovered")
    print("if the public exponent e is also known.")
