# Q24: RSA Private Key Calculation

import math


def extended_gcd(a, b):
    if b == 0:
        return a, 1, 0

    gcd, x1, y1 = extended_gcd(b, a % b)

    x = y1
    y = x1 - (a // b) * y1

    return gcd, x, y


print("RSA PRIVATE KEY CALCULATION")
print("---------------------------")

e = int(input("Enter public exponent e: "))
n = int(input("Enter n: "))

# Find p and q by trial division
p = None
q = None

for i in range(2, int(n ** 0.5) + 1):

    if n % i == 0:
        p = i
        q = n // i
        break

if p is None:
    print("Could not factor n.")
    exit()

print("\np =", p)
print("q =", q)

# Euler's phi
phi = (p - 1) * (q - 1)

print("phi(n) =", phi)

# Extended Euclidean algorithm
gcd, x, y = extended_gcd(e, phi)

if gcd != 1:
    print("Private key does not exist.")
    exit()

d = x % phi

print("\nPrivate key d =", d)

print("\nPublic key:")
print("(e, n) =", (e, n))

print("\nPrivate key:")
print("(d, n) =", (d, n))

